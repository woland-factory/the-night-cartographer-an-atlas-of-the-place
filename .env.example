# The Night Cartographer runs fully in the browser. There is no backend and
# no secret it needs to work. These optional values are read by the staging
# container entrypoint and written into config.js at start. All are empty by
# default, which keeps analytics and error tracking switched off.

# Seed and auto-open the sample atlas on a fresh visit ("1" to enable).
SEED_DEMO=

# Umami analytics (both required to switch it on). Automatic pageview only.
UMAMI_URL=
UMAMI_WEBSITE_ID=

# Sentry-compatible error tracking DSN (leave empty to keep it off).
SENTRY_DSN=
